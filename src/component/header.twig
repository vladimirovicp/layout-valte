<header id="header" class="header">
  <div class="container">

    <div class="container header__container">

      <a href="/" class="logo header__logo">
        <img src="/src/img/alt-linux-logo.svg" alt="vALTe" class="logo__image">
        <span class="logo__text">vALTe</span>
      </a>


      <nav class="nav header__nav">
        <ul class="nav__list">
           {% for nav in header %}
              <li class="nav__item {% if active_nav == nav.link %}active{% endif %}">
                <a href="{{ nav.link }}" class="nav__link">{{ nav.name }}</a>
              </li>
           {% endfor %}
        </ul>
      </nav>

      {# <button class="burger header__burger" type="button" aria-label="Открыть меню">
        <span class="burger__line"></span>
        <span class="burger__line"></span>
        <span class="burger__line"></span>
      </button> #}

    </div>
  </div>
</header>
